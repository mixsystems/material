{
  "compilerOptions": {
    "strict": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "importHelpers": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "types": [],
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true
  },
  "angularCompilerOptions": {
    "preserveWhitespaces": false
  },
  "compileOnSave": false,
  "buildOnSave": false
}
