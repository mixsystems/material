{
    "scripts": {
        "prepare": "husky",
        "prepare-release": "lerna version --conventional-commits --no-git-tag-version --no-push",
        "prepare-minor-release": "lerna version minor --conventional-commits --no-git-tag-version --no-push",
        "prepare-patch-release": "lerna version patch --conventional-commits --no-git-tag-version --no-push",
        "commit-release": "node tools/commit-release.js",
        "commitmsg": "commitlint -e"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-lerna-scopes": "^21.2.0",
        "husky": "^9.1.7",
        "lerna": "^10.1.1",
        "simple-git": "^4.0.2"
    },
    "overrides": {
        "undici@>=7.0.0 <7.30.1": "^7.30.1"
    }
}
